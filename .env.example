# ─────────────────────────────────────────────────────────────────────────────
# ApplyOS runs with none of these set.
#
# With no configuration it stores everything in your browser's IndexedDB, which
# is private, instant, and works offline. Set the Supabase pair below when you
# want the same workspace on more than one device.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (optional) — run supabase/migrations/0001_init.sql first.
# Read the security note at the top of that file before exposing an instance.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Browser-extension capture (optional, server-only).
# Needs Supabase, since a server route can't reach a browser-local workspace.
# Generate with: openssl rand -hex 32
SUPABASE_SERVICE_ROLE_KEY=
APPLYOS_CAPTURE_TOKEN=
